# ==============================================================================
# TECHNURTURE LABS — ENVIRONMENT TEMPLATE
# ==============================================================================
# Copy this file to .env and fill in your values.
# This file is committed to git — it must NEVER contain real credentials.
# ==============================================================================

NODE_ENV=development

# ──────────────────────────────────────────────────────────────────────────────
# DATABASE
# ──────────────────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:admin@localhost:5433/technurturelabs"

# ──────────────────────────────────────────────────────────────────────────────
# REDIS
# ──────────────────────────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ──────────────────────────────────────────────────────────────────────────────
# AUTH
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# ──────────────────────────────────────────────────────────────────────────────
JWT_SECRET=your-jwt-secret-min-32-chars-change-this

# ──────────────────────────────────────────────────────────────────────────────
# TOTP ENCRYPTION (AES-256-GCM)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must be exactly 64 hex chars. Once set, do not rotate.
# ──────────────────────────────────────────────────────────────────────────────
APP_ENCRYPTION_KEY=your-64-hex-char-encryption-key-here

# ──────────────────────────────────────────────────────────────────────────────
# MEDIA + CRON SECRETS
# ──────────────────────────────────────────────────────────────────────────────
MEDIA_SECRET=your-media-signing-secret
CRON_SECRET=your-cron-secret-for-maintenance-endpoint

# ──────────────────────────────────────────────────────────────────────────────
# CLOUDFLARE R2 STORAGE
# Get from: Cloudflare Dashboard → R2 → Manage R2 API tokens
# ──────────────────────────────────────────────────────────────────────────────
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_ACCESS_KEY_ID=your-r2-access-key-id
CLOUDFLARE_SECRET_ACCESS_KEY=your-r2-secret-access-key
CLOUDFLARE_BUCKET_NAME=your-bucket-name
# R2 custom domain or pub-xxx.r2.dev URL
CLOUDFLARE_PUBLIC_DOMAIN=
# Cloudflare Worker URL for HLS video streaming (optional)
CLOUDFLARE_WORKER_URL=

# ──────────────────────────────────────────────────────────────────────────────
# APP URL
# ──────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ──────────────────────────────────────────────────────────────────────────────
# RAZORPAY — use TEST keys for dev, LIVE keys for production
# Get from: https://dashboard.razorpay.com/app/keys
# ──────────────────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id
